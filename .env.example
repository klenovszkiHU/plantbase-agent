# Plantbase — környezeti változók (másold .env-re és töltsd ki)
# A .env SOHA ne kerüljön a repóba (lásd .gitignore).

# --- LLM ---
# Anthropic API kulcs a termék-agenthez (askAgent).
ANTHROPIC_API_KEY=

# A termék-agent modellje. Aktuális, stabil Claude modell; költségérzékeny demóhoz felülírható.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Adatbázis: két kapcsolat, két jog (architektura.md 2. pont, NFR1) ---
# READ-WRITE — ezzel viszi a Prisma a sémát, migrációt és a seedet.
DATABASE_URL=postgresql://plantbase:plantbase@localhost:5432/plantbase?schema=public

# READ-ONLY — ezt használja az agent runSql toolja (csak SELECT).
DATABASE_URL_READONLY=postgresql://plantbase_ro:plantbase_ro@localhost:5432/plantbase?schema=public
